{
  "name": "thegame Codespace",

  // Build from your Dockerfile (so that apt-get and npm install -g serve actually happen)
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": { "VARIANT": "18" }
  },

  // Run as the built-in 'node' user
  "remoteUser": "node",

  // Forward your Vite port so you can preview in the browser pane
  "forwardPorts": [8026],

  // After the container is created, install your deps
  "postCreateCommand": "npm install && npm install playcanvas vite --save-dev",

  // Recommend these handy VS Code extensions
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      }
    }
  }
}
